@model Yönetim_Paneli.Models.Teknisyen
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" class="light-style layout-menu-fixed" dir="ltr" data-theme="theme-default" data-assets-path="~/assets/" data-template="vertical-menu-template-free">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>Yeni Personel Tanımlama - Bilgi İşlem Terminali</title>

    <link rel="stylesheet" href="~/assets/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="~/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/assets/vendor/css/theme-default.css" />
    <link rel="stylesheet" href="~/assets/css/demo.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="tech-body">
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    <a href="/Home/Index" class="app-brand-link">
                        <span class="app-brand-text demo menu-text fw-bolder ms-2">Bilgi İşlem</span>
                    </a>
                </div>
                <ul class="menu-inner py-1">
                    <li class="menu-item">
                        <a href="/Home/Index" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-home-circle"></i>
                            <div>Ana Panel</div>
                        </a>
                    </li>
                    <li class="menu-header small text-uppercase"><span class="menu-header-text">İşlemler</span></li>
                    <li class="menu-item">
                        <a href="/Home/ArizaEkle" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-wrench"></i>
                            <div>Arıza Talepleri</div>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a href="/Home/EnvanterListesi" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-desktop"></i>
                            <div>Donanım Envanteri</div>
                        </a>
                    </li>
                    <li class="menu-item active">
                        <a href="/Home/PersonelListesi" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-user-pin"></i>
                            <div>Personel Yönetimi</div>
                        </a>
                    </li>
                </ul>
            </aside>

            <div class="layout-page">
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row justify-content-center">
                            <div class="col-xl-9 col-lg-11">

                                <div class="card tech-card mb-4 mt-3">
                                    <div class="tech-card-header d-flex justify-content-between align-items-center py-3">
                                        <h5 class="mb-0 tech-title">
                                            <i class="bx bx-user-plus me-2 text-success"></i>SİSTEME YENİ TEKNİK PERSONEL ENJEKTE ET
                                        </h5>
                                        <span class="badge bg-label-success px-3 py-2">PERSONEL ALTYAPISI</span>
                                    </div>
                                    <div class="card-body mt-4">
                                        <form action="/Home/PersonelEkle" method="post">

                                            <div class="row">
                                                <div class="col-md-6 mb-4">
                                                    <label class="tech-label" for="SicilNo">Teknisyen Sicil No / ID Code</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text tech-input border-end-0"><i class="bx bx-qr-scan text-muted"></i></span>
                                                        <input type="text" class="form-control tech-input" id="SicilNo" name="SicilNo" placeholder="Örn: BİL-2026-01" required />
                                                    </div>
                                                </div>

                                                <div class="col-md-6 mb-4">
                                                    <label class="tech-label" for="AdSoyad">Personel Adı Soyadı</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text tech-input border-end-0"><i class="bx bx-user text-muted"></i></span>
                                                        <input type="text" class="form-control tech-input" id="AdSoyad" name="AdSoyad" placeholder="Örn: Muhammed Bilal Kılıç" required />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 mb-4">
                                                    <label class="tech-label" for="Unvan">Sistem Unvanı / Rolü</label>
                                                    <select class="form-select tech-input" id="Unvan" name="Unvan" required>
                                                        <option value="" disabled selected hidden>Rol Seçiniz...</option>
                                                        <option value="Bilgi İşlem Sorumlusu">Bilgi İşlem Sorumlusu</option>
                                                        <option value="Sistem ve Ağ Uzmanı">Sistem ve Ağ Uzmanı</option>
                                                        <option value="Teknik Destek Personeli">Teknik Destek Personeli</option>
                                                        <option value="IT Stajyeri">IT Stajyeri</option>
                                                    </select>
                                                </div>

                                                <div class="col-md-6 mb-4">
                                                    <label class="tech-label" for="Telefon">İletişim Hattı (Telefon)</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text tech-input border-end-0"><i class="bx bx-phone text-muted"></i></span>
                                                        <input type="tel" class="form-control tech-input" id="Telefon" name="Telefon" placeholder="Örn: 0555 XXXXXXX" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-end gap-3 mt-5">
                                                <a href="/Home/PersonelListesi" class="btn btn-tech-secondary">Vazgeç</a>
                                                <button type="submit" class="btn btn-tech-primary">
                                                    <i class="bx bx-save me-1"></i>Personeli Ağaç Yapısına Kaydet
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</body>
</html>