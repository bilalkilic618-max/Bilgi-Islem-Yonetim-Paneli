@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>E-Posta Doğrulama - bilaltech</title>
    <link rel="stylesheet" href="~/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/assets/vendor/css/theme-default.css" />
    <link rel="stylesheet" href="~/assets/vendor/fonts/boxicons.css" />
    <style>
            body {
                background-color: #0f172a !important;
                background-image: radial-gradient(circle at 10% 20%, rgba(59, 130, 246, 0.1) 0%, transparent 40%), radial-gradient(circle at 90% 80%, rgba(99, 102, 241, 0.1) 0%, transparent 40%);
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
            }

            .auth-card {
                background: #1e293b !important;
                border: 1px solid #334155 !important;
                border-radius: 12px;
                padding: 2.5rem;
                width: 100%;
                max-width: 420px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            }

            .form-control {
                background-color: #0f172a !important;
                border: 1px solid #334155 !important;
                color: #ffffff !important;
                letter-spacing: 6px;
                font-size: 1.3rem;
                font-weight: bold;
            }

                .form-control:focus {
                    background-color: #0f172a !important;
                    border-color: #3b82f6 !important;
                    color: #ffffff !important;
                    box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25) !important;
                }

            .form-label {
                color: #cbd5e1 !important;
            }
    </style>
</head>
<body>
    <div class="auth-card text-center">
        <div class="mb-4">
            <div class="avatar avatar-xl bg-label-primary mx-auto mb-3 p-3 rounded-circle" style="width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; background: rgba(59, 130, 246, 0.15);">
                <i class="bx bx-envelope fs-1 text-primary"></i>
            </div>
            <h4 class="mb-2" style="color: #ffffff;">E-Posta Adresinizi Doğrulayın</h4>
            <p style="color: #94a3b8; font-size: 0.9rem;">
                <strong style="color: #38bdf8;">@(ViewBag.Email ?? "E-posta")</strong> adresinize gönderilen 6 haneli onay kodunu aşağıya giriniz.
            </p>
        </div>

        @if (ViewBag.HataMesaji != null)
        {
            <div class="alert alert-danger mb-3 text-start" style="background-color: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #fca5a5; padding: 12px; font-size: 0.88rem; border-radius: 8px;">
                <i class="bx bx-error-circle me-1"></i> @ViewBag.HataMesaji
            </div>
        }

        <form action="/Home/EmailDogrula" method="POST" autocomplete="off">
            <!-- E-posta bilgisini gizli olarak gönderiyoruz -->
            <input type="hidden" name="email" value="@ViewBag.Email" />

            <div class="mb-4">
                <label for="kod" class="form-label text-uppercase text-start d-block">6 Haneli Onay Kodu</label>
                <input type="text" class="form-control text-center" id="kod" name="kod" maxlength="6" placeholder="••••••" required autofocus />
            </div>

            <button class="btn btn-primary d-grid w-100 mb-3" type="submit" style="background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%) !important; border: none !important; padding: 10px; font-weight: bold;">
                Kodu Onayla ve Tamamla
            </button>

            <div class="mt-3">
                <a href="/Home/Login" style="color: #94a3b8; text-decoration: none; font-size: 0.85rem;">
                    <i class="bx bx-left-arrow-alt"></i> Giriş Ekranına Dön
                </a>
            </div>
        </form>
    </div>
</body>
</html>
