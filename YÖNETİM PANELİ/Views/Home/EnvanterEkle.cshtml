@model Yönetim_Paneli.Models.Envanter
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr" class="light-style layout-menu-fixed" dir="ltr" data-theme="theme-default" data-assets-path="~/assets/" data-template="vertical-menu-template-free">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>Yeni Malzeme Ekle - Donanım Envanteri</title>

    <link rel="stylesheet" href="~/assets/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="~/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/assets/vendor/css/theme-default.css" />
    <link rel="stylesheet" href="~/assets/css/demo.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="tech-body">
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            <!-- SOL MENÜ -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    <a href="/Home/Index" class="app-brand-link">
                        <span class="app-brand-text demo menu-text fw-bolder ms-2">Bilgi İşlem</span>
                    </a>
                </div>
                <ul class="menu-inner py-1">
                    <li class="menu-item">
                        <a href="/Home/Index" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-home-circle"></i>
                            <div>Ana Panel</div>
                        </a>
                    </li>
                    <li class="menu-header small text-uppercase"><span class="menu-header-text">İşlemler</span></li>
                    <li class="menu-item">
                        <a href="/Home/DepoYonetimi" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-package"></i>
                            <div>Depo Yönetimi</div>
                        </a>
                    </li>
                    <li class="menu-item active">
                        <a href="/Home/EnvanterListesi" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-desktop"></i>
                            <div>Donanım Envanteri</div>
                        </a>
                    </li>
                </ul>
            </aside>

            <!-- İÇERİK ALANI -->
            <div class="layout-page">
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row justify-content-center">
                            <div class="col-xl-9 col-lg-11">

                                <div class="card tech-card mb-4 mt-3">
                                    <div class="tech-card-header d-flex justify-content-between align-items-center py-3">
                                        <h5 class="mb-0 tech-title"><i class="bx bx-barcode-reader me-2 text-info"></i>ENVANTERE YENİ CİHAZ (BARKODLU) EKLE</h5>
                                        <span class="badge bg-label-info px-3 py-2">BİLGİ İŞLEM MİMARİSİ</span>
                                    </div>
                                    <div class="card-body mt-4">

                                        @if (ViewBag.HataMesaji != null)
                                        {
                                            <div class="alert alert-danger mb-4">@ViewBag.HataMesaji</div>
                                        }

                                        <form action="/Home/EnvanterEkle" method="post" enctype="multipart/form-data">

                                            <!-- 🌟 BARKOD OKUTMA ALANI -->
                                            <div class="row mb-4">
                                                <div class="col-md-12">
                                                    <label class="tech-label fw-bold text-primary" for="BarkodNo"><i class="bx bx-scan me-1"></i>Cihaz Barkod / Seri Numarası</label>
                                                    <div class="input-group input-group-lg">
                                                        <span class="input-group-text"><i class="bx bx-barcode"></i></span>
                                                        <input type="text" class="form-control tech-input" id="BarkodNo" name="BarkodNo" placeholder="Lütfen barkod okuyucu ile okutun veya manuel girin..." autofocus required autocomplete="off" />
                                                    </div>
                                                    <small class="text-muted mt-1 d-block">Barkodu okuttuğunuzda sistem otomatik olarak alt kutuya (Malzeme Adı'na) geçecektir.</small>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 mb-4">
                                                    <label class="tech-label" for="MalzemeAdi">Bileşen / Malzeme Adı</label>
                                                    <input type="text" class="form-control tech-input" id="MalzemeAdi" name="MalzemeAdi" placeholder="Örn: Ağ Anahtarı (Switch), SSD, Ram" required />
                                                </div>

                                                <div class="col-md-6 mb-4">
                                                    <label class="tech-label" for="MarkaModel">Marka / Model / Özellik</label>
                                                    <input type="text" class="form-control tech-input" id="MarkaModel" name="MarkaModel" placeholder="Örn: Kingston DataTraveler" />
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 mb-4">
                                                    <label class="tech-label" for="Adet">Mevcut Stok Adeti</label>
                                                    <input type="number" class="form-control tech-input" id="Adet" name="Adet" value="1" min="1" required />
                                                </div>

                                                <div class="col-md-6 mb-4">
                                                    <label class="tech-label" for="FotografDosyasi">Bileşen Görseli (Fotoğraf)</label>
                                                    <input type="file" class="form-control tech-input" id="FotografDosyasi" name="FotografDosyasi" accept="image/*" />
                                                </div>
                                            </div>

                                            <div class="mb-4">
                                                <label class="tech-label" for="Aciklama">Donanım Açıklaması / Konum / Durum</label>
                                                <textarea class="form-control tech-input" id="Aciklama" name="Aciklama" rows="3" placeholder="Örn: Sistem odası ana kabinet içi..."></textarea>
                                            </div>

                                            <div class="d-flex justify-content-end gap-3 mt-5">
                                                <a href="/Home/EnvanterListesi" class="btn btn-tech-secondary">Vazgeç</a>
                                                <button type="submit" class="btn btn-tech-primary"><i class="bx bx-terminal me-1"></i>Sisteme Enjekte Et</button>
                                            </div>
                                        </form>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- 🌟 BARKOD OKUYUCU KLAVYE KONTROL SCRİPTİ -->
    <script>
            document.getElementById('BarkodNo').addEventListener('keydown', function(event) {
                // Cihaz barkodu okuduktan sonra Enter tuşuna basar (keyCode 13)
                if (event.key === 'Enter' || event.keyCode === 13) {
                    event.preventDefault(); // Formu yanlışlıkla göndermeyi engelle
                    document.getElementById('MalzemeAdi').focus(); // Bir sonraki kutuya geç
                }
            });
    </script>
</body>
</html>