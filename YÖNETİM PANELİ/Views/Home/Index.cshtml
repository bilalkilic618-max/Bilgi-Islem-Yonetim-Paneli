@model List<Yönetim_Paneli.Models.Ariza>
@{
    ViewData["Title"] = "Ana Panel - Arıza Talepleri";
}

<div class="container-fluid flex-grow-1 container-p-y">
    <!-- Özet İstatistik Kartları -->
    <!-- MOBİL UYUM: row sınıfına g-3 eklendi, sütunlar col-12 col-sm-6 col-md-3 olarak düzeltildi -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size:0.8rem;">Toplam Arıza</h6>
                        <h3 class="text-primary mb-0">@ViewBag.ToplamAriza</h3>
                    </div>
                    <div class="avatar avatar-md bg-label-primary p-2 rounded">
                        <i class="bx bx-wrench fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size:0.8rem;">Bekleyen</h6>
                        <h3 class="text-warning mb-0">@ViewBag.BekleyenAriza</h3>
                    </div>
                    <div class="avatar avatar-md bg-label-warning p-2 rounded">
                        <i class="bx bx-time-five fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size:0.8rem;">Hazır</h6>
                        <h3 class="text-info mb-0">@(ViewBag.HazirAriza ?? 0)</h3>
                    </div>
                    <div class="avatar avatar-md bg-label-info p-2 rounded">
                        <i class="bx bx-package fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size:0.8rem;">Çözülen</h6>
                        <h3 class="text-success mb-0">@ViewBag.CozulenAriza</h3>
                    </div>
                    <div class="avatar avatar-md bg-label-success p-2 rounded">
                        <i class="bx bx-check-circle fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 📊 DİNAMİK GRAFİK ALANI (CHART.JS) -->
    <!-- MOBİL UYUM: g-3 eklendi, col-12 col-md-X olarak düzenlendi -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-5">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-header border-bottom border-secondary py-3">
                    <h5 class="mb-0 text-white fs-6"><i class="bx bx-pie-chart-alt-2 me-2 text-primary"></i>Arıza Durum Oranları</h5>
                </div>
                <!-- MOBİL UYUM: min-height mobilde daha orantılı durması için revize edildi -->
                <div class="card-body d-flex align-items-center justify-content-center p-3" style="min-height: 200px;">
                    <canvas id="durumChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-7">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-header border-bottom border-secondary py-3">
                    <h5 class="mb-0 text-white fs-6"><i class="bx bx-bar-chart-alt-2 me-2 text-primary"></i>Cihaz Türlerine Göre Dağılım</h5>
                </div>
                <div class="card-body p-3" style="min-height: 200px;">
                    <canvas id="cihazChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Arıza Listesi Tablosu -->
    <div class="card bg-dark text-white border-secondary">
        <!-- MOBİL UYUM: Header flex-column flex-sm-row ve gap eklendi -->
        <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 border-bottom border-secondary py-3">
            <h5 class="mb-0 text-white fs-6">Aktif Arıza Kayıtları</h5>
            <!-- MOBİL UYUM: Buton mobilde tam genişlik (w-100), masaüstünde otomatik boyut -->
            <a href="/Home/ArizaEkle" class="btn btn-primary btn-sm w-100 w-sm-auto">+ Yeni Arıza Kaydı</a>
        </div>

        <!-- Zaten var olan table-responsive sayesinde tablo yana kaydırılabilecek -->
        <div class="table-responsive text-nowrap">
            <table class="table table-dark table-hover mb-0">
                <thead>
                    <tr>
                        <th>Personel</th>
                        <th>Departman</th>
                        <th>Cihaz</th>
                        <th>Açıklama</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.AdSoyad</strong><br /><small class="text-muted">@item.PersonelNo</small></td>
                                <td>@item.Departman</td>
                                <td><span class="badge bg-label-info">@item.CihazTuru</span></td>
                                <!-- MOBİL UYUM: Uzun açıklamaların mobilde tabloyu patlatmaması için maksimum genişlik eklendi -->
                                <td style="max-width: 200px; white-space: normal; word-wrap: break-word;">@item.HataAciklaması</td>
                                <td>
                                    @if (item.Durum == "Çözüldü" || item.Durum == "Tamamlandı" || item.Durum == "ÇÖZÜLDÜ")
                                    {
                                        <span class="badge bg-success">@item.Durum</span>
                                    }
                                    else if (item.Durum == "HAZIR" || item.Durum == "Hazır")
                                    {
                                        <span class="badge bg-info">@item.Durum</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">@item.Durum</span>
                                    }
                                </td>
                                <td>
                                    <!-- MOBİL UYUM: Butonlar d-flex ve gap-1 ile mobilde alt alta/yan yana düzenli hale getirildi -->
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (item.Durum != "Çözüldü" && item.Durum != "Tamamlandı" && item.Durum != "ÇÖZÜLDÜ")
                                        {
                                            <form action="/Home/DurumCozulduYap/@item.Id" method="post" class="d-inline m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Çözüldü İşaretle">
                                                    <i class="bx bx-check"></i>
                                                </button>
                                            </form>
                                        }
                                        <a href="/Home/ArizaDuzenle/@item.Id" class="btn btn-sm btn-outline-primary"><i class="bx bx-edit"></i></a>
                                        <form action="/Home/ArizaSil/@item.Id" method="post" class="d-inline m-0" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bx bx-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <!-- DÜZELTİLEN KISIM BURASI KANKA -->
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted" style="white-space: normal;">
                                <i class="bx bx-info-circle fs-3 d-block mb-2 text-secondary"></i>
                                Henüz kayıtlı arıza bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Chart.js Kütüphanesi ve Grafik Scriptleri -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // 1. Arıza Durum Grafiği (Donut Chart)
        const ctxDurum = document.getElementById('durumChart').getContext('2d');
        new Chart(ctxDurum, {
            type: 'doughnut',
            data: {
                labels: ['Bekleyen', 'Hazır', 'Çözülen'],
                datasets: [{
                    data: [@ViewBag.BekleyenAriza, @(ViewBag.HazirAriza ?? 0), @ViewBag.CozulenAriza],
                    backgroundColor: ['#f59e0b', '#06b6d4', '#10b981'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#cbd5e1', boxWidth: 12 }
                    }
                }
            }
        });

        // 2. Cihaz Türlerine Göre Dağılım Grafiği (Bar Chart)
        @{
                var cihazGruplari = Model.GroupBy(x => string.IsNullOrEmpty(x.CihazTuru) ? "Diğer" : x.CihazTuru)
                                                                                                                                                                                                        .Select(g => new { Cihaz = g.Key, Adet = g.Count() }).ToList();
                var cihazEtiketleri = string.Join(",", cihazGruplari.Select(x => "'" + x.Cihaz + "'"));
                var cihazVerileri = string.Join(",", cihazGruplari.Select(x => x.Adet));
            }

                    const ctxCihaz = document.getElementById('cihazChart').getContext('2d');
        new Chart(ctxCihaz, {
            type: 'bar',
            data: {
                labels: [@Html.Raw(cihazEtiketleri)],
                datasets: [{
                    label: 'Arıza Sayısı',
                    data: [@cihazVerileri],
                    backgroundColor: '#3b82f6',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { ticks: { color: '#cbd5e1', maxRotation: 45, minRotation: 45 }, grid: { display: false } },
                    y: { ticks: { color: '#cbd5e1', stepSize: 1 }, grid: { color: '#334155' } }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    });
</script>